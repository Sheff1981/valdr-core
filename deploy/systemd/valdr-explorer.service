[Unit]
Description=VALDR Testnet read-only Explorer
Documentation=https://github.com/Sheff1981/valdr-core
Wants=network-online.target
After=network-online.target valdrd.service
Requires=valdrd.service

[Service]
Type=simple
User=valdr
Group=valdr
UMask=0077
ExecStart=/usr/local/bin/valdr-explorer --listen 127.0.0.1:8080 --node http://127.0.0.1:17332 --index-file /var/lib/valdr/explorer/index.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/valdr
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
